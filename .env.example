# Copy this file to .env. Git ignores .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Local inference never reads a provider API key.
LOCAL_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_CONTEXT_SIZE=4096
# Optional USD per million tokens. Leave blank if unknown.
# Estimates use input/output usage, not cache discounts or taxes.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
